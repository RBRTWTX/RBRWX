{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RBR WX",
  "version": "0.2.0",
  "identifier": "com.rbrwx.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RBR WX",
        "width": 1600,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "output",
        "title": "RBR WX Output",
        "url": "index.html?window=output",
        "width": 1920,
        "height": 1080,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://tiles.openfreemap.org https://services.arcgisonline.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
