{
  "name": "rbr-wx",
  "version": "0.2.0",
  "private": true,
  "description": "RBR WX local broadcast weather workstation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "validate:architecture": "node tools/validate-architecture.mjs",
    "validate:versions": "node tools/validate-versions.mjs",
    "validate": "npm run validate:versions && npm run validate:architecture && npm run check && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "html-to-image": "1.11.13",
    "maplibre-gl": "6.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.0.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "6.0.2",
    "vite": "7.3.6"
  }
}
